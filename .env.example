# --- required on Railway ---
TELEGRAM_BOT_TOKEN=
# signals channel / chat
TELEGRAM_CHAT_ID=
# heartbeat + errors (empty = same as TELEGRAM_CHAT_ID)
TELEGRAM_STATUS_CHAT_ID=
# Railway Redis URL (empty = in-memory, for local tests)
REDIS_URL=

# --- optional overrides (defaults from the white paper) ---
# EXCHANGES=okx,binance
# RVOL_MIN_1H=3.0
# RVOL_MIN_15M=4.0
# PRICE_MOVE_MIN=2.0
# MIN_24H_VOLUME_USD=2000000
# MIN_LISTING_AGE_DAYS=7
# COOLDOWN_HOURS=2
# MIN_SCORE_TO_ALERT=60
# RISK_PER_TRADE_USD=20
# WATCHLIST=NIGHT,SOL
# BLACKLIST=USDC
# DRY_RUN=false
